{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Spike main window — needs global shortcut + invoke for the 6 probe commands",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "global-shortcut:allow-register",
    "global-shortcut:allow-unregister",
    "global-shortcut:allow-is-registered"
  ]
}
